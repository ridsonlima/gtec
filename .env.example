# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Local:      postgresql://postgres:postgres@localhost:5432/gtec_db
# Supabase:   postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gtec_db"

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
# URL base da aplicação
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta (mínimo 32 caracteres, gere com: openssl rand -base64 32)
NEXTAUTH_SECRET="sua-chave-secreta-de-no-minimo-32-caracteres-aqui"

# ─── SUPABASE STORAGE ────────────────────────────────────────────────────────
# URL do projeto Supabase
SUPABASE_URL="https://XXXXXXXXXXX.supabase.co"

# Chave anônima (pública)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Chave de service role (PRIVADA — nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Nome do bucket de storage
SUPABASE_STORAGE_BUCKET="gtec-attachments"

# ─── CRON JOB ────────────────────────────────────────────────────────────────
# Segredo para autenticar chamadas do job agendado (Vercel Cron ou externo)
CRON_SECRET="cron-secret-seguro-aqui"

# ─── AMBIENTE ────────────────────────────────────────────────────────────────
NODE_ENV="development"
