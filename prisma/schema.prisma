generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── ENUMS (convertidos para String - compatibilidade SQLite) ────────────────















// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String      @default("viewer")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  loginCount   Int       @default(0) @map("login_count")
  // ─── Integração Approvo (códigos por usuário, para ver só a própria fila) ──
  approvoTipoAcesso     String? @default("C") @map("approvo_tipo_acesso")
  approvoCodUsuario     Int?    @map("approvo_cod_usuario")
  approvoCodPerfil      Int?    @map("approvo_cod_perfil")
  approvoCodUsuarioMega Int?    @map("approvo_cod_usuario_mega")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  areaScopes                UserAreaScope[]
  reportsAuthored           Report[]              @relation("ReportAuthor")
  demandsCreated            Demand[]              @relation("DemandCreator")
  demandsOwned              Demand[]              @relation("DemandResponsible")
  demandsAccepted           Demand[]              @relation("DemandAccepted")
  demandsRejected           Demand[]              @relation("DemandRejected")
  comments                  Comment[]
  demandUpdates             DemandUpdate[]
  demandUpdateReactions     DemandUpdateReaction[] @relation("DemandUpdateReactions")
  demandUpdateReplies       DemandUpdateReply[]    @relation("DemandUpdateReplies")
  areasResponsavel          Area[]                 @relation("AreaResponsavel")
  acompanhamentosAnalista   RelatorioAcompanhamento[] @relation("AcompanhamentoAnalista")
  restricoesResponsavel     ObraRestricao[]           @relation("RestricoesResponsavel")
  restricoesCriadas         ObraRestricao[]           @relation("RestricoesCriadas")
  interferenciasCriadas     ObraInterferencia[]       @relation("InterferenciasCriadas")
  avancosCriados            ObraAvancoFisico[]        @relation("AvancosCriados")
  checklistsSolicitados     VeiculoChecklist[]        @relation("ChecklistSolicitante")
  checklistsAprovados       VeiculoChecklist[]        @relation("ChecklistAprovador")
  attachments               Attachment[]
  evidenceRequests          EvidenceRequest[]     @relation("EvidenceRequester")
  evidenceResponsible       EvidenceRequest[]     @relation("EvidenceResponsible")
  notifications             Notification[]
  auditLogs                 AuditLog[]
  contractsOwned            Contract[]
  agendasCreated            MeetingAgenda[]
  projectsOwned             Project[]             @relation("ProjectResponsible")
  demandCollaborations      DemandCollaborator[]       @relation("DemandCollaborators")
  demandCollaborationsAdded DemandCollaborator[]       @relation("DemandCollaboratorAdder")
  deadlineRequestsMade      DeadlineExtensionRequest[] @relation("DeadlineRequestedBy")
  deadlineRequestsReviewed  DeadlineExtensionRequest[] @relation("DeadlineReviewedBy")
  demandUpdateViews         DemandUpdateView[]
  mentions                  Mention[]
  demandChecklistItems      DemandChecklistItem[]
  medicoesCriadas           Medicao[]
  adiantamentosCriados      Adiantamento[]
  fechamentosCreados        FechamentoMensal[]    @relation("FechamentosCreados")
  transacoesCriadas         Transacao[]           @relation("TransacoesCriadas")
  alocacoesCreadas          AlocacaoAtivo[]       @relation("AlocacoesCreadas")
  medicoesLocacaoCriadas    MedicaoLocacao[]      @relation("MedicoesLocacaoCriadas")
  medicoesLocacaoAprovadas  MedicaoLocacao[]      @relation("MedicoesAprovadas")
  medicoesConferidas        MedicaoLocacao[]      @relation("MedicoesConferidas")
  auditoriasRealizadas      AuditoriaVisita[]     @relation("AuditoriasRealizadas")
  pendenciasResponsavel     PendenciaAuditoria[]  @relation("PendenciasResponsavel")
  ordensServicoCriadas      OrdemServico[]        @relation("OrdensServicoCriadas")
  osUpdates                 OrdemServicoUpdate[]  @relation("OSUpdates")
  tarefasPessoais           TarefaPessoal[]       @relation("TarefasPessoais")
  ausenciasComoUsuario      AvisoAusencia[]       @relation("AusenciaUsuario")
  ausenciasComoSubstituto   AvisoAusencia[]       @relation("AusenciaSubstituto")
  ausenciasCriadas          AvisoAusencia[]       @relation("AusenciaCriadoPor")
  comunicadosCriados        Comunicado[]          @relation("ComunicadosCriados")
  comunicadoLeituras        ComunicadoLeitura[]   @relation("ComunicadoLeituras")

  @@map("users")
}

// ─── USER AREA SCOPES ────────────────────────────────────────────────────────

model UserAreaScope {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  areaId    String  @map("area_id")
  canWrite  Boolean @default(false) @map("can_write")
  isPrimary Boolean @default(false) @map("is_primary")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@map("user_area_scopes")
}

// ─── AREAS ───────────────────────────────────────────────────────────────────

model Area {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  parentId      String?  @map("parent_id")
  responsibleId String?  @map("responsible_id")
  isOperational Boolean  @default(false) @map("is_operational")
  isActive      Boolean  @default(true) @map("is_active")
  description   String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  responsible      User?           @relation("AreaResponsavel", fields: [responsibleId], references: [id])
  parent           Area?           @relation("AreaChildren", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children         Area[]          @relation("AreaChildren")
  userScopes       UserAreaScope[]
  reports          Report[]
  contracts        Contract[]
  demands          Demand[]
  requestedDemands Demand[]        @relation("DemandRequestingArea")
  comunicados      Comunicado[]    @relation("ComunicadosArea")

  @@index([parentId])
  @@map("areas")
}

// ─── CONTRACTS ───────────────────────────────────────────────────────────────

model Contract {
  id             String         @id @default(uuid())
  areaId         String         @map("area_id")
  number         String         
  name           String         
  client         String         
  description    String?       
  estimatedValue Float?         @map("estimated_value") 
  startDate      DateTime?      @map("start_date")
  endDate        DateTime?      @map("end_date")
  responsibleId      String?  @map("responsible_id")
  contractType       String?  @map("contract_type")
  status             String   @default("active")
  physicalProgress   Float?   @map("physical_progress")
  financialProgress  Float?   @map("financial_progress")
  riskNotes          String?  @map("risk_notes")
  executionModality  String   @default("own_crew") @map("execution_modality")
  // ─── Reajuste ────────────────────────────────────────────────────────────
  proposalDate       DateTime? @map("proposal_date")
  readjustmentCount  Int       @default(0) @map("readjustment_count")
  readjustmentIndex  String?   @map("readjustment_index")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  area               Area               @relation(fields: [areaId], references: [id])
  responsible        User?              @relation(fields: [responsibleId], references: [id])
  reports            Report[]
  demands            Demand[]
  attachments        Attachment[]       @relation("ContractAttachments")
  evidenceRequests   EvidenceRequest[]  @relation("ContractEvidence")
  contractPartners   ContractPartner[]
  contractors        Contractor[]
  medicoes           Medicao[]
  fechamentosMensais FechamentoMensal[]
  alocacoesAtivos    AlocacaoAtivo[]
  medicoesLocacao    MedicaoLocacao[]   @relation("MedicoesLocacao")
  auditoriasVisita   AuditoriaVisita[]  @relation("AuditoriasContrato")
  funcionarios       Funcionario[]      @relation("FuncionarioContrato")
  acompanhamentos    RelatorioAcompanhamento[] @relation("AcompanhamentoContrato")
  obraRestricoes     ObraRestricao[]           @relation("ObraRestricoes")
  obraInterferencias ObraInterferencia[]       @relation("ObraInterferencias")
  obraAvancos        ObraAvancoFisico[]        @relation("ObraAvancos")
  projetos           Project[]                 @relation("ContractProjetos")

  @@map("contracts")
}

// ─── REPORTS ─────────────────────────────────────────────────────────────────

model Report {
  id               String       @id @default(uuid())
  areaId           String       @map("area_id")
  contractId       String?      @map("contract_id")
  authorId         String       @map("author_id")
  title            String       
  period           String?      
  status           String @default("draft")
  executiveSummary String?      @map("executive_summary")
  evolutions       String?     
  criticalPoints   String?      @map("critical_points")
  attentionPoints  String?      @map("attention_points")
  risks            String?     
  blockers         String?     
  decisionsNeeded  String?      @map("decisions_needed")
  nextSteps        String?      @map("next_steps")
  pendingItems     String?      @map("pending_items")
  agendaSuggestion String?      @map("agenda_suggestion")
  hasCritical      Boolean      @default(false) @map("has_critical")
  hasDecisionNeeded Boolean     @default(false) @map("has_decision_needed")
  publishedAt      DateTime?    @map("published_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  projectId        String?      @map("project_id")
  area             Area              @relation(fields: [areaId], references: [id])
  contract         Contract?         @relation(fields: [contractId], references: [id])
  project          Project?          @relation("ReportProjeto", fields: [projectId], references: [id])
  author           User              @relation("ReportAuthor", fields: [authorId], references: [id])
  versions         ReportVersion[]
  comments         Comment[]         @relation("ReportComments")
  evidenceRequests EvidenceRequest[] @relation("ReportEvidence")
  attachments      Attachment[]      @relation("ReportAttachments")
  demands          Demand[]
  agendaItems      AgendaItem[]      @relation("ReportAgenda")

  @@index([areaId, status])
  @@index([publishedAt])
  @@map("reports")
}

// ─── REPORT VERSIONS ─────────────────────────────────────────────────────────

model ReportVersion {
  id            String   @id @default(uuid())
  reportId      String   @map("report_id")
  versionNumber Int      @map("version_number")
  snapshot      String
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, versionNumber])
  @@map("report_versions")
}

// ─── DEMANDS ─────────────────────────────────────────────────────────────────

model Demand {
  id               String    @id @default(uuid())
  areaId           String    @map("area_id")
  requestingAreaId String?   @map("requesting_area_id")
  contractId       String?   @map("contract_id")
  reportId         String?   @map("report_id")
  projectId        String?   @map("project_id")
  title            String
  context          String?
  responsibleId    String    @map("responsible_id")
  createdById      String    @map("created_by_id")
  status           String    @default("pending")
  priority         String    @default("medium")
  dueDate          DateTime  @map("due_date")
  completedAt      DateTime? @map("completed_at")
  blockers         String?
  supportNeeded    String?   @map("support_needed")
  origin           String    @default("manager")
  isOverdue        Boolean   @default(false) @map("is_overdue")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Campos de workflow de aceite (apenas para demandas interárea)
  acceptanceStatus String?   @map("acceptance_status") // pending_acceptance | accepted | rejected
  slaDeadline      DateTime? @map("sla_deadline")
  slaStatus        String?   @map("sla_status")        // ok | warning | breached
  acceptedAt       DateTime? @map("accepted_at")
  acceptedById     String?   @map("accepted_by_id")
  rejectedAt       DateTime? @map("rejected_at")
  rejectedById     String?   @map("rejected_by_id")
  rejectionReason  String?   @map("rejection_reason")

  area             Area                @relation(fields: [areaId], references: [id])
  requestingArea   Area?               @relation("DemandRequestingArea", fields: [requestingAreaId], references: [id])
  contract         Contract?           @relation(fields: [contractId], references: [id])
  report           Report?             @relation(fields: [reportId], references: [id])
  project          Project?            @relation(fields: [projectId], references: [id])
  responsible      User                @relation("DemandResponsible", fields: [responsibleId], references: [id])
  createdBy        User                @relation("DemandCreator", fields: [createdById], references: [id])
  acceptedBy       User?               @relation("DemandAccepted", fields: [acceptedById], references: [id])
  rejectedBy       User?               @relation("DemandRejected", fields: [rejectedById], references: [id])
  updates          DemandUpdate[]
  checklistItems   DemandChecklistItem[]
  comments         Comment[]           @relation("DemandComments")
  attachments      Attachment[]        @relation("DemandAttachments")
  evidenceRequests EvidenceRequest[]   @relation("DemandEvidence")
  agendaItems      AgendaItem[]        @relation("DemandAgenda")
  collaborators      DemandCollaborator[]
  deadlineRequests   DeadlineExtensionRequest[]

  @@index([areaId, status])
  @@index([requestingAreaId])
  @@index([acceptanceStatus])
  @@index([slaDeadline])
  @@index([acceptedById])
  @@index([rejectedById])
  @@index([dueDate, status])
  @@index([responsibleId])
  @@map("demands")
}

// ─── DEMAND CHECKLIST ────────────────────────────────────────────────────────

model DemandChecklistItem {
  id          String    @id @default(uuid())
  demandId    String    @map("demand_id")
  title       String
  description String?
  dueDate     DateTime? @map("due_date")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  demand      Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([demandId])
  @@map("demand_checklist_items")
}

// ─── DEMAND UPDATES ───────────────────────────────────────────────────────────

model DemandUpdate {
  id           String        @id @default(uuid())
  demandId     String        @map("demand_id")
  authorId     String        @map("author_id")
  content      String       
  statusBefore String? @map("status_before")
  statusAfter  String? @map("status_after")
  createdAt    DateTime      @default(now()) @map("created_at")

  demand    Demand                 @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author    User                   @relation(fields: [authorId], references: [id])
  views     DemandUpdateView[]
  reactions DemandUpdateReaction[]
  replies   DemandUpdateReply[]

  @@index([demandId])
  @@map("demand_updates")
}

model DemandUpdateReaction {
  id        String   @id @default(uuid())
  updateId  String   @map("update_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  update DemandUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User         @relation("DemandUpdateReactions", fields: [userId], references: [id])

  @@unique([updateId, userId, emoji])
  @@index([updateId])
  @@map("demand_update_reactions")
}

model DemandUpdateReply {
  id        String   @id @default(uuid())
  updateId  String   @map("update_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  update DemandUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author User         @relation("DemandUpdateReplies", fields: [authorId], references: [id])

  @@index([updateId])
  @@map("demand_update_replies")
}

model DemandUpdateView {
  updateId String   @map("update_id")
  userId   String   @map("user_id")
  seenAt   DateTime @default(now()) @map("seen_at")

  update DemandUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([updateId, userId])
  @@index([userId])
  @@map("demand_update_views")
}

// ─── COMMENTS ────────────────────────────────────────────────────────────────

model Comment {
  id         String      @id @default(uuid())
  objectType String  @map("object_type")
  objectId   String      @map("object_id")
  parentId   String?     @map("parent_id")
  authorId   String      @map("author_id")
  type       String @default("observation")
  content    String     
  dueDate    DateTime?   @map("due_date")
  isResolved Boolean     @default(false) @map("is_resolved")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  parent          Comment?         @relation("CommentThread", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies         Comment[]        @relation("CommentThread")
  author          User             @relation(fields: [authorId], references: [id])
  evidenceRequest EvidenceRequest?
  mentions        Mention[]

  reportRef Report?  @relation("ReportComments", fields: [objectId], references: [id], map: "comment_report_ref_fk")
  demandRef Demand?  @relation("DemandComments", fields: [objectId], references: [id], map: "comment_demand_ref_fk")

  @@index([objectType, objectId])
  @@index([authorId])
  @@map("comments")
}

// ─── EVIDENCE REQUESTS ───────────────────────────────────────────────────────

model EvidenceRequest {
  id            String         @id @default(uuid())
  objectType    String     @map("object_type")
  objectId      String         @map("object_id")
  commentId     String?        @unique @map("comment_id")
  requestedById String         @map("requested_by_id")
  responsibleId String         @map("responsible_id")
  description   String        
  dueDate       DateTime?      @map("due_date")
  status        String @default("pending")
  responseNotes String?        @map("response_notes")
  createdAt     DateTime       @default(now()) @map("created_at")
  resolvedAt    DateTime?      @map("resolved_at")

  comment     Comment?     @relation(fields: [commentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy User         @relation("EvidenceRequester", fields: [requestedById], references: [id])
  responsible User         @relation("EvidenceResponsible", fields: [responsibleId], references: [id])
  attachments Attachment[] @relation("EvidenceAttachments")

  reportRef   Report?   @relation("ReportEvidence", fields: [objectId], references: [id], map: "ev_report_ref_fk")
  contractRef Contract? @relation("ContractEvidence", fields: [objectId], references: [id], map: "ev_contract_ref_fk")
  demandRef   Demand?   @relation("DemandEvidence", fields: [objectId], references: [id], map: "ev_demand_ref_fk")

  @@index([objectType, objectId])
  @@index([responsibleId, status])
  @@map("evidence_requests")
}

// ─── ATTACHMENTS ─────────────────────────────────────────────────────────────

model Attachment {
  id                String     @id @default(uuid())
  objectType        String @map("object_type")
  objectId          String     @map("object_id")
  uploadedById      String     @map("uploaded_by_id")
  originalName      String     @map("original_name") 
  storageKey        String     @map("storage_key") 
  mimeType          String     @map("mime_type") 
  sizeBytes         Int     @map("size_bytes")
  evidenceRequestId String?    @map("evidence_request_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  evidenceRequest EvidenceRequest? @relation("EvidenceAttachments", fields: [evidenceRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  reportRef   Report?   @relation("ReportAttachments", fields: [objectId], references: [id], map: "att_report_ref_fk")
  demandRef   Demand?   @relation("DemandAttachments", fields: [objectId], references: [id], map: "att_demand_ref_fk")
  contractRef Contract? @relation("ContractAttachments", fields: [objectId], references: [id], map: "att_contract_ref_fk")

  @@index([objectType, objectId])
  @@map("attachments")
}

// ─── PROJECTS (V2 — schema preparado) ────────────────────────────────────────

model Project {
  id              String        @id @default(uuid())
  name            String
  objective       String?
  contractId      String?       @map("contract_id")     // obra (projeto) sob um contrato; contrato guarda-chuva = vários projetos
  responsibleId   String        @map("responsible_id")
  status          String @default("planned")
  startDate       DateTime?     @map("start_date")
  expectedEndDate DateTime?     @map("expected_end_date")
  riskLevel       String     @default("low") @map("risk_level")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  contract        Contract?     @relation("ContractProjetos", fields: [contractId], references: [id])
  responsibleUser User          @relation("ProjectResponsible", fields: [responsibleId], references: [id])
  milestones  ProjectMilestone[]
  updates     ProjectUpdate[]
  demands     Demand[]
  reports     Report[]           @relation("ReportProjeto")
  alocacoes   AlocacaoAtivo[]
  medicaoItens MedicaoLocacaoItem[] @relation("ItensLocacaoProjeto")
  auditoriasVisita AuditoriaVisita[] @relation("AuditoriasVisita")

  @@map("projects")
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String    
  description String?  
  dueDate     DateTime  @map("due_date")
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model ProjectUpdate {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  content   String  
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

// ─── MEETING AGENDAS ─────────────────────────────────────────────────────────

model MeetingAgenda {
  id          String    @id @default(uuid())
  title       String
  objective   String?
  meetingDate DateTime? @map("meeting_date")
  scheduledAt DateTime? @map("scheduled_at")
  createdById String    @map("created_by_id")
  status      String    @default("preparing")
  // diretoria | interarea | externo
  tipo        String    @default("diretoria")
  // IDs de áreas envolvidas (JSON array) — para pautas interárea
  areasEnvolvidas       String? @map("areas_envolvidas")
  // Descrição dos participantes externos (texto livre, indicativo)
  participantesExternos String? @map("participantes_externos")
  // Seções de evolução / situação / próximos passos
  evolucoes      String?
  situacao       String?
  proximosPassos String? @map("proximos_passos")
  // Data proposta para próxima reunião
  proximaReuniao DateTime? @map("proxima_reuniao")
  notes       String?
  minutesText String? @map("minutes_text")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User         @relation(fields: [createdById], references: [id])
  items     AgendaItem[]

  @@index([tipo])
  @@index([createdById])
  @@map("meeting_agendas")
}

model AgendaItem {
  id               String           @id @default(uuid())
  agendaId         String           @map("agenda_id")
  order            Int              @default(0)
  title            String           
  description      String?         
  origin           String?          
  reportId         String?          @map("report_id")
  demandId         String?          @map("demand_id")
  estimatedMinutes Int?             @map("estimated_minutes")
  status           String @default("pending")
  decisionMade     String?          @map("decision_made")
  notes            String?
  // Registro por item (Evoluções / Situação / Próximos Passos)
  evolucoes        String?
  situacao         String?
  proximosPassos   String?          @map("proximos_passos")
  createdAt        DateTime         @default(now()) @map("created_at")

  agenda   MeetingAgenda @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  report   Report?       @relation("ReportAgenda", fields: [reportId], references: [id])
  demand   Demand?       @relation("DemandAgenda", fields: [demandId], references: [id])

  @@index([agendaId, order])
  @@map("agenda_items")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       String
  title      String           
  body       String?         
  link       String?          
  objectType String?      @map("object_type")
  objectId   String?          @map("object_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  readAt     DateTime?        @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── DEMAND COLLABORATORS ────────────────────────────────────────────────────

model DemandCollaborator {
  id        String   @id @default(uuid())
  demandId  String   @map("demand_id")
  userId    String   @map("user_id")
  role      String   @default("contributor")
  addedById String   @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  demand  Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  user    User   @relation("DemandCollaborators", fields: [userId], references: [id])
  addedBy User   @relation("DemandCollaboratorAdder", fields: [addedById], references: [id])

  @@unique([demandId, userId])
  @@index([demandId])
  @@index([userId])
  @@index([addedById])
  @@map("demand_collaborators")
}

// ─── DEADLINE EXTENSION REQUESTS ─────────────────────────────────────────────

model DeadlineExtensionRequest {
  id            String    @id @default(uuid())
  demandId      String    @map("demand_id")
  requestedById String    @map("requested_by_id")
  proposedDate  DateTime  @map("proposed_date")
  justification String
  status        String    @default("pending") // pending | approved | rejected
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")
  createdAt     DateTime  @default(now()) @map("created_at")

  demand      Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("DeadlineRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("DeadlineReviewedBy", fields: [reviewedById], references: [id])

  @@index([demandId])
  @@index([requestedById])
  @@index([status])
  @@map("deadline_extension_requests")
}

// ─── MENTIONS ────────────────────────────────────────────────────────────────

model Mention {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([userId])
  @@map("mentions")
}

// ─── MEDICAO ─────────────────────────────────────────────────────────────────

model Medicao {
  id                  String   @id @default(uuid())
  contractId          String   @map("contract_id")
  contractPartnerId   String?  @map("contract_partner_id")
  competenciaAno      Int      @map("competencia_ano")
  competenciaMes      Int      @map("competencia_mes")
  valorProduzido      Float    @map("valor_produzido")
  valorAprovado       Float    @map("valor_aprovado")
  valorFaturado       Float    @map("valor_faturado")
  folhaPagamento      Float?   @map("folha_pagamento")
  materiaisDiretosCDG Float?   @map("materiais_diretos_cdg")
  observacoes         String?
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  contract        Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractPartner ContractPartner? @relation(fields: [contractPartnerId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  adiantamentos   Adiantamento[]

  @@unique([contractId, contractPartnerId, competenciaAno, competenciaMes])
  @@index([contractId])
  @@index([contractPartnerId])
  @@map("medicoes")
}

model Adiantamento {
  id                String   @id @default(uuid())
  medicaoId         String   @map("medicao_id")
  valor             Float
  dataAdiantamento  DateTime @map("data_adiantamento")
  descricao         String?
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")

  medicao   Medicao @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([medicaoId])
  @@map("adiantamentos")
}

// ─── EMPRESA PARCEIRA ────────────────────────────────────────────────────────

model EmpresaParceira {
  id           String   @id @default(uuid())
  name         String
  cnpj         String?  @unique
  contactName  String?  @map("contact_name")
  contactPhone String?  @map("contact_phone")
  tipo         String   @default("terceiro") // empresa_a | empresa_b | terceiro
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contractPartners ContractPartner[]

  @@map("empresas_parceiras")
}

// ─── CONTRACT PARTNER (vínculo contrato ↔ empresa parceira) ──────────────────

model ContractPartner {
  id                       String   @id @default(uuid())
  contractId               String   @map("contract_id")
  empresaParceiraId        String   @map("empresa_parceira_id")
  percentageTotal          Float    @map("percentage_total")
  percentualAdministracao  Float?   @map("percentual_administracao")  // % taxa adm (empresa_a, ex: 10)
  valorMinimoAdministracao Float?   @map("valor_minimo_administracao")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  contract        Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)
  empresaParceira EmpresaParceira     @relation(fields: [empresaParceiraId], references: [id])
  instrumentos    InstrumentoFiscal[]
  medicoes        Medicao[]
  itensLocacao    ItemLocacao[]

  @@unique([contractId, empresaParceiraId])
  @@index([contractId])
  @@map("contract_partners")
}

// ─── ITEM DE LOCAÇÃO (itens do contrato Empresa B) ────────────────────────────

model ItemLocacao {
  id                String   @id @default(uuid())
  contractPartnerId String   @map("contract_partner_id")
  descricao         String
  placa             String?
  franquiaMensal    Float    @map("franquia_mensal")
  unidadeExcedente  String   @default("hora") @map("unidade_excedente") // hora | km
  valorExcedente    Float    @map("valor_excedente")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  contractPartner ContractPartner  @relation(fields: [contractPartnerId], references: [id], onDelete: Cascade)
  usos            UsoItemLocacao[]

  @@index([contractPartnerId])
  @@map("itens_locacao")
}

// ─── FECHAMENTO MENSAL ────────────────────────────────────────────────────────

model FechamentoMensal {
  id               String    @id @default(uuid())
  contractId       String    @map("contract_id")
  competenciaAno   Int       @map("competencia_ano")
  competenciaMes   Int       @map("competencia_mes")
  // Etapa 1 — PC Contratual (custo direto CDG)
  folhaPagamento   Float?    @map("folha_pagamento")
  materiaisDiretos Float?    @map("materiais_diretos")
  pcContratual     Float?    @map("pc_contratual")
  // Etapa 2 — ND Contratual (taxa adm Empresa A)
  ndContratual     Float?    @map("nd_contratual")
  ndNumero         String?   @map("nd_numero")
  ndEmissao        DateTime? @map("nd_emissao")
  // Etapa 3 — PC Real
  pcReal           Float?    @map("pc_real")
  // Meta 90% (calculado a partir das transações)
  totalSaidaCDG    Float?    @map("total_saida_cdg")
  totalComNF       Float?    @map("total_com_nf")
  // NF da Empresa A (taxa de administração)
  nfAdmNumero      String?   @map("nf_adm_numero")
  nfAdmValor       Float?    @map("nf_adm_valor")
  // Adiantamentos pagos à Empresa A no mês (para cálculo da ND)
  adiantEmpresaA   Float?    @map("adiant_empresa_a")
  // Controle
  status           String    @default("aberto") // aberto | pc_lancado | nd_lancada | fechado
  observacoes      String?
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("FechamentosCreados", fields: [createdById], references: [id])
  transacoes Transacao[]
  usosItens  UsoItemLocacao[]

  @@unique([contractId, competenciaAno, competenciaMes])
  @@index([contractId])
  @@map("fechamentos_mensais")
}

// ─── TRANSAÇÃO (hipóteses 1-8) ────────────────────────────────────────────────

model Transacao {
  id            String    @id @default(uuid())
  fechamentoId  String    @map("fechamento_id")
  hipotese      Int       // 1-8
  descricao     String
  valor         Float
  beneficiario  String?
  dataPagamento DateTime? @map("data_pagamento")
  nfNumero      String?   @map("nf_numero")
  observacoes   String?
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  fechamento FechamentoMensal @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("TransacoesCriadas", fields: [createdById], references: [id])

  @@index([fechamentoId])
  @@map("transacoes")
}

// ─── USO MENSAL DE ITEM DE LOCAÇÃO ────────────────────────────────────────────

model UsoItemLocacao {
  id             String   @id @default(uuid())
  fechamentoId   String   @map("fechamento_id")
  itemLocacaoId  String   @map("item_locacao_id")
  horasOuKm      Float    @map("horas_ou_km")
  valorFranquia  Float    @map("valor_franquia")
  valorExcedente Float    @map("valor_excedente")
  valorTotal     Float    @map("valor_total")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  fechamento  FechamentoMensal @relation(fields: [fechamentoId], references: [id], onDelete: Cascade)
  itemLocacao ItemLocacao      @relation(fields: [itemLocacaoId], references: [id])

  @@unique([fechamentoId, itemLocacaoId])
  @@index([fechamentoId])
  @@map("usos_itens_locacao")
}

// ─── INSTRUMENTO FISCAL ───────────────────────────────────────────────────────

model InstrumentoFiscal {
  id                String   @id @default(uuid())
  contractPartnerId String   @map("contract_partner_id")
  tipo              String   // gestao_obra | locacao_maquinas | nota_debito | outro
  descricao         String?
  percentage        Float?   // null = nota de débito (residual calculado)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  contractPartner ContractPartner @relation(fields: [contractPartnerId], references: [id], onDelete: Cascade)

  @@index([contractPartnerId])
  @@map("instrumentos_fiscais")
}

// ─── CONTRACTOR (EMPREITEIRO) ─────────────────────────────────────────────────

model Contractor {
  id                  String   @id @default(uuid())
  contractId          String   @map("contract_id")
  name                String
  cnpj                String?
  contactName         String?  @map("contact_name")
  contactPhone        String?  @map("contact_phone")
  serviceDescription  String   @map("service_description")
  contractedValue     Float    @map("contracted_value")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contractors")
}

// ─── FROTA — ATIVO (equipamento / veículo) ───────────────────────────────────

model Ativo {
  id                 String   @id @default(uuid())
  tag                String   @unique                  // ex: EQP-042, VEI-017
  tipo               String                            // equipamento | veiculo
  categoria          String                            // escavadeira | caminhão | compactador | etc.
  descricao          String
  marca              String?
  modelo             String?
  anoFabricacao      Int?     @map("ano_fabricacao")
  placa              String?  @unique
  numeroserie        String?  @map("numero_serie")
  valorLocacaoMensal Float    @map("valor_locacao_mensal")
  status             String   @default("disponivel")  // disponivel | alocado | manutencao | inativo
  observacoes        String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  alocacoes      AlocacaoAtivo[]
  ordensServico  OrdemServico[]
  auditoriaItens AuditoriaItem[]
  medicaoItens   MedicaoLocacaoItem[]
  acompanhamentos RelatorioAcompAtivo[] @relation("AcompAtivo")
  condutorAtualId String?  @map("condutor_atual_id")
  condutorAtual   Condutor? @relation("AtivoCondutor", fields: [condutorAtualId], references: [id])
  multas         VeiculoMulta[]     @relation("VeiculoMultas")
  documentos     VeiculoDocumento[] @relation("VeiculoDocumentos")
  checklists     VeiculoChecklist[] @relation("VeiculoChecklists")

  @@index([status])
  @@index([tipo, categoria])
  @@map("ativos")
}

// ─── FROTA — ALOCAÇÃO DE ATIVO (por contrato + trecho) ───────────────────────

model AlocacaoAtivo {
  id          String    @id @default(uuid())
  ativoId     String    @map("ativo_id")
  contratoId  String    @map("contrato_id")
  projetoId   String?   @map("projeto_id")            // trecho / frente de serviço
  dataInicio  DateTime  @map("data_inicio")
  dataFim     DateTime? @map("data_fim")              // null = ainda alocado
  observacoes String?
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  ativo     Ativo    @relation(fields: [ativoId], references: [id])
  contrato  Contract @relation(fields: [contratoId], references: [id])
  projeto   Project? @relation(fields: [projetoId], references: [id])
  createdBy User     @relation("AlocacoesCreadas", fields: [createdById], references: [id])

  @@index([ativoId])
  @@index([contratoId])
  @@index([projetoId])
  @@index([dataFim])
  @@map("alocacoes_ativos")
}

// ─── FROTA — MEDIÇÃO DE LOCAÇÃO (faturamento CDG Locações) ───────────────────

model MedicaoLocacao {
  id               String    @id @default(uuid())
  contratoId       String    @map("contrato_id")
  competenciaAno   Int       @map("competencia_ano")
  competenciaMes   Int       @map("competencia_mes")
  status           String    @default("rascunho")
  // rascunho | aguard_supervisor | enviada | aprovada | guia_gerada | paga | rejeitada
  moduloTipo       String    @default("veiculo") @map("modulo_tipo")
  // veiculo | equipamento
  totalGeral       Float     @default(0) @map("total_geral")
  observacoes      String?
  aprovadorId      String?   @map("aprovador_id")
  dataAprovacao    DateTime? @map("data_aprovacao")
  rejeicaoMotivo   String?   @map("rejeicao_motivo")
  guiaPdfKey       String?   @map("guia_pdf_key")
  comprovantePdfKey String?  @map("comprovante_pdf_key")
  dataPagamento    DateTime? @map("data_pagamento")
  // Conferência do supervisor de obra (etapa obrigatória)
  supervisorId          String?   @map("supervisor_id")
  supervisorAprovadoEm  DateTime? @map("supervisor_aprovado_em")
  supervisorNota        String?   @map("supervisor_nota")
  createdById      String    @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  contrato    Contract  @relation("MedicoesLocacao", fields: [contratoId], references: [id])
  aprovador   User?     @relation("MedicoesAprovadas", fields: [aprovadorId], references: [id])
  supervisor  User?     @relation("MedicoesConferidas", fields: [supervisorId], references: [id])
  createdBy   User      @relation("MedicoesLocacaoCriadas", fields: [createdById], references: [id])
  itens     MedicaoLocacaoItem[]

  @@unique([contratoId, competenciaAno, competenciaMes])
  @@index([contratoId])
  @@index([status])
  @@map("medicoes_locacao")
}

model MedicaoLocacaoItem {
  id             String  @id @default(uuid())
  medicaoId      String  @map("medicao_id")
  ativoId        String  @map("ativo_id")
  projetoId      String? @map("projeto_id")
  diasAtivos     Int     @map("dias_ativos")
  valorUnitario  Float   @map("valor_unitario")
  totalItem      Float   @map("total_item")
  observacoes    String?

  medicao MedicaoLocacao @relation(fields: [medicaoId], references: [id], onDelete: Cascade)
  ativo   Ativo          @relation(fields: [ativoId], references: [id])
  projeto Project?       @relation("ItensLocacaoProjeto", fields: [projetoId], references: [id])

  @@index([medicaoId])
  @@index([ativoId])
  @@map("medicao_locacao_itens")
}

// ─── FROTA — AUDITORIA DE CAMPO ───────────────────────────────────────────────

model AuditoriaVisita {
  id          String    @id @default(uuid())
  projetoId   String?   @map("projeto_id")
  contratoId  String?   @map("contrato_id")
  auditorId   String    @map("auditor_id")
  dataVisita  DateTime  @map("data_visita")
  status      String    @default("agendada")
  // agendada | em_andamento | concluida | cancelada
  moduloTipo  String    @default("veiculo") @map("modulo_tipo")
  // veiculo | equipamento
  observacoes String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  projeto    Project?        @relation("AuditoriasVisita", fields: [projetoId], references: [id])
  contrato   Contract?       @relation("AuditoriasContrato", fields: [contratoId], references: [id])
  auditor    User            @relation("AuditoriasRealizadas", fields: [auditorId], references: [id])
  itens      AuditoriaItem[]
  pendencias PendenciaAuditoria[]

  @@index([auditorId])
  @@index([status])
  @@index([dataVisita])
  @@map("auditoria_visitas")
}

model AuditoriaItem {
  id           String  @id @default(uuid())
  visitaId     String  @map("visita_id")
  ativoId      String  @map("ativo_id")
  categoria    String
  // seguranca | manutencao | operacao | documentacao
  descricao    String
  conformidade String  @default("ok")
  // ok | atencao | critica
  fotoKey      String? @map("foto_key")
  observacao   String?

  visita AuditoriaVisita     @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  ativo  Ativo               @relation(fields: [ativoId], references: [id])
  pendencia PendenciaAuditoria?

  @@index([visitaId])
  @@index([ativoId])
  @@map("auditoria_itens")
}

model PendenciaAuditoria {
  id           String    @id @default(uuid())
  visitaId     String    @map("visita_id")
  itemId       String?   @unique @map("item_id")
  descricao    String
  severidade   String    // atencao | critica
  prazo        DateTime?
  status       String    @default("aberta")
  // aberta | em_tratativa | resolvida | reincidente
  responsavelId String?  @map("responsavel_id")
  resolucaoNota String?  @map("resolucao_nota")
  resolvidaEm  DateTime? @map("resolvida_em")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  visita      AuditoriaVisita @relation(fields: [visitaId], references: [id])
  item        AuditoriaItem?  @relation(fields: [itemId], references: [id])
  responsavel User?           @relation("PendenciasResponsavel", fields: [responsavelId], references: [id])

  @@index([visitaId])
  @@index([status])
  @@index([responsavelId])
  @@map("pendencias_auditoria")
}

// ─── FROTA — ORDEM DE SERVIÇO (manutenção) ───────────────────────────────────

model OrdemServico {
  id           String    @id @default(uuid())
  ativoId      String    @map("ativo_id")
  tipo         String                            // preventiva | corretiva
  descricao    String
  status       String    @default("aberta")
  // aberta | em_execucao | concluida | cancelada
  dataAbertura DateTime  @default(now()) @map("data_abertura")
  dataPrevista DateTime? @map("data_prevista")
  dataConclusao DateTime? @map("data_conclusao")
  custo        Float?
  executante   String?
  observacoes  String?
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ativo     Ativo @relation(fields: [ativoId], references: [id])
  createdBy User  @relation("OrdensServicoCriadas", fields: [createdById], references: [id])
  updates   OrdemServicoUpdate[]

  @@index([ativoId])
  @@index([status])
  @@index([tipo])
  @@map("ordens_servico")
}

// ─── FROTA — ATUALIZAÇÕES DE OS ──────────────────────────────────────────────

model OrdemServicoUpdate {
  id        String   @id @default(uuid())
  osId      String   @map("os_id")
  authorId  String   @map("author_id")
  content   String
  tipo      String   @default("atualizacao")
  // atualizacao | problema_encontrado | peca_substituida | observacao
  custo     Float?
  createdAt DateTime @default(now()) @map("created_at")

  os     OrdemServico @relation(fields: [osId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author User         @relation("OSUpdates", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([osId])
  @@map("os_updates")
}

// ─── SEGURANÇA DO TRABALHO — ACIDENTES ───────────────────────────────────────

model Acidente {
  id                   String    @id @default(uuid())
  codigo               String?
  nome                 String
  cargo                String?
  dataAdmissao         DateTime? @map("data_admissao")
  dataOcorrencia       DateTime  @map("data_ocorrencia")
  trechoObra           String?   @map("trecho_obra")
  mes                  String
  ano                  Int       @default(2026)
  diasPerdidos         Int       @default(0) @map("dias_perdidos")
  tipoAcidente         String    @map("tipo_acidente")        // Típico | Trajeto
  afastamento          String                                 // ASA | ACA
  horarioAcidente      String?   @map("horario_acidente")
  turno                String?
  areaLesionada        String?   @map("area_lesionada")
  situacaoInvestigacao String?   @map("situacao_investigacao")
  valoresGastos        Float?    @map("valores_gastos")
  cid                  String?
  agenteCausador       String?   @map("agente_causador")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([mes, ano])
  @@index([tipoAcidente])
  @@index([afastamento])
  @@map("acidentes")
}

// ─── SEGURANÇA DO TRABALHO — TAXA DE FREQUÊNCIA ───────────────────────────────

model TaxaFrequencia {
  id                      String   @id @default(uuid())
  mes                     String
  ano                     Int      @default(2026)
  totalEmpregados         Int      @map("total_empregados")
  totalHorasTrabalhadas   Float    @map("total_horas_trabalhadas")
  acidentesComAfastamento Int      @default(0) @map("acidentes_com_afastamento")
  acidentesSemAfastamento Int      @default(0) @map("acidentes_sem_afastamento")
  totalAcidentes          Int      @default(0) @map("total_acidentes")
  diasPerdidos            Int      @default(0) @map("dias_perdidos")
  diasDebitados           Float?   @map("dias_debitados")
  totalDiasPerdidos       Int      @default(0) @map("total_dias_perdidos")
  taxaFrequencia          Float    @default(0) @map("taxa_frequencia")
  taxaGravidade           Float    @default(0) @map("taxa_gravidade")
  indiceRelativo          Float?   @map("indice_relativo")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@unique([mes, ano])
  @@map("taxa_frequencia")
}

// ─── SEGURANÇA DO TRABALHO — CONFIGURAÇÃO ────────────────────────────────────

model SegurancaConfig {
  id                     String   @id @default(uuid())
  ano                    Int      @default(2026)
  diasSemAcidentes       Int      @default(0) @map("dias_sem_acidentes")
  treinamentosConforme   Int      @default(0) @map("treinamentos_conforme")
  treinamentosNecessitam Int      @default(0) @map("treinamentos_necessitam")
  totalCustos            Float    @default(0) @map("total_custos")
  inspecaoSeguranca      Int      @default(0) @map("inspecao_seguranca")
  dssRealizados          Int      @default(0) @map("dss_realizados")
  mesReferencia          String   @default("ABRIL") @map("mes_referencia")
  syncedAt               DateTime @default(now()) @map("synced_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([ano])
  @@map("seguranca_config")
}

// ─── SEGURANÇA — CONTROLE DE FUNCIONÁRIOS ────────────────────────────────────

model Funcionario {
  id           String    @id @default(uuid())
  nome         String
  cpf          String?
  matricula    String?
  cargo        String?
  fotoUrl      String?   @map("foto_url")
  empresa      String?                              // nome da empresa (própria ou terceira)
  vinculo      String    @default("proprio")        // proprio | terceirizado
  situacao     String    @default("contratado")     // contratado | avulso
  regime       String    @default("clt")            // diaria | clt | pj
  alojado      Boolean   @default(false)
  alojamento   String?                              // local/identificação do alojamento
  contrato     String?                              // texto livre (legado / observação de lotação)
  contratoId   String?   @map("contrato_id")        // alocação no contrato real
  ativo        Boolean   @default(true)
  observacoes  String?
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  treinamentos FuncionarioTreinamento[]
  contratoRef  Contract? @relation("FuncionarioContrato", fields: [contratoId], references: [id])

  @@index([vinculo])
  @@index([ativo])
  @@index([empresa])
  @@index([contratoId])
  @@map("funcionarios")
}

model DemandView {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  demandId  String   @map("demand_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  @@unique([userId, demandId])
  @@index([userId])
  @@map("demand_views")
}

model EmpresaFuncionario {
  id        String   @id @default(uuid())
  nome      String   @unique
  tipo      String?                          // propria | terceira
  cnpj      String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("empresas_funcionario")
}

model Funcao {
  id           String   @id @default(uuid())
  nome         String   @unique
  ativo        Boolean  @default(true)
  treinamentos String[] @default([])         // nomes dos treinamentos necessários para a função
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("funcoes")
}

// ─── VEÍCULOS — CONDUTORES, DOCUMENTOS, CHECKLIST ────────────────────────────

model Condutor {
  id           String    @id @default(uuid())
  nome         String
  cnh          String?
  categoriaCnh String?   @map("categoria_cnh")
  validadeCnh  DateTime? @map("validade_cnh")
  telefone     String?
  observacoes  String?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  veiculos Ativo[]         @relation("AtivoCondutor")
  multas   VeiculoMulta[]

  @@map("condutores")
}

model VeiculoMulta {
  id           String    @id @default(uuid())
  ativoId      String    @map("ativo_id")
  condutorId   String?   @map("condutor_id")
  dataInfracao DateTime  @map("data_infracao")
  infracao     String
  local        String?
  valor        Float?
  pontos       Int?
  vencimento   DateTime?
  status       String    @default("pendente")   // pendente | pago | recorrido | indicado
  observacoes  String?
  anexoUrl     String?   @map("anexo_url")
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  ativo    Ativo     @relation("VeiculoMultas", fields: [ativoId], references: [id])
  condutor Condutor? @relation(fields: [condutorId], references: [id])

  @@index([ativoId])
  @@index([condutorId])
  @@map("veiculo_multas")
}

model VeiculoDocumento {
  id          String    @id @default(uuid())
  ativoId     String    @map("ativo_id")
  tipo        String                            // seguro | ipva | licenciamento | outro
  descricao   String?
  valor       Float?
  vencimento  DateTime?
  anexoUrl    String?   @map("anexo_url")
  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  ativo Ativo @relation("VeiculoDocumentos", fields: [ativoId], references: [id])

  @@index([ativoId])
  @@map("veiculo_documentos")
}

model VeiculoChecklist {
  id               String    @id @default(uuid())
  ativoId          String    @map("ativo_id")
  solicitanteId    String    @map("solicitante_id")
  km               Int?
  observacoes      String?
  status           String    @default("pendente") // pendente | aprovado | reprovado
  aprovadorId      String?   @map("aprovador_id")
  aprovadoEm       DateTime? @map("aprovado_em")
  motivoReprovacao String?   @map("motivo_reprovacao")
  createdAt        DateTime  @default(now()) @map("created_at")

  ativo       Ativo                  @relation("VeiculoChecklists", fields: [ativoId], references: [id])
  solicitante User                   @relation("ChecklistSolicitante", fields: [solicitanteId], references: [id])
  aprovador   User?                  @relation("ChecklistAprovador", fields: [aprovadorId], references: [id])
  fotos       VeiculoChecklistFoto[]

  @@index([ativoId])
  @@index([status])
  @@map("veiculo_checklists")
}

model VeiculoChecklistFoto {
  id          String   @id @default(uuid())
  checklistId String   @map("checklist_id")
  item        String                          // chave do roteiro (frente, traseira, painel…)
  fotoUrl     String   @map("foto_url")
  createdAt   DateTime @default(now()) @map("created_at")

  checklist VeiculoChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("veiculo_checklist_fotos")
}

// ─── GESTÃO DE OBRA (Obras Próprias) ─────────────────────────────────────────

model ObraRestricao {
  id            String    @id @default(uuid())
  contratoId    String    @map("contrato_id")
  descricao     String
  categoria     String    @default("outro")    // material | licenca | projeto | frente | mao_obra | equipamento | outro
  impacto       String?                        // o que trava se não resolver
  responsavelId String    @map("responsavel_id")
  prazo         DateTime
  status        String    @default("aberta")   // aberta | removida
  removidaEm    DateTime? @map("removida_em")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  contrato    Contract @relation("ObraRestricoes", fields: [contratoId], references: [id])
  responsavel User     @relation("RestricoesResponsavel", fields: [responsavelId], references: [id])
  createdBy   User     @relation("RestricoesCriadas", fields: [createdById], references: [id])

  @@index([contratoId, status])
  @@index([responsavelId, status])
  @@map("obra_restricoes")
}

model ObraInterferencia {
  id                 String    @id @default(uuid())
  contratoId         String    @map("contrato_id")
  tipo               String    @default("interferencia") // interferencia | paralisacao
  local              String?                             // trecho / estaca / endereço
  descricao          String
  responsavelExterno String?   @map("responsavel_externo") // concessionária, prefeitura, projeto…
  dataInicio         DateTime  @map("data_inicio")
  dataFim            DateTime? @map("data_fim")           // null = ainda travado
  status             String    @default("aberta")         // aberta | resolvida
  createdById        String    @map("created_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  contrato  Contract @relation("ObraInterferencias", fields: [contratoId], references: [id])
  createdBy User     @relation("InterferenciasCriadas", fields: [createdById], references: [id])

  @@index([contratoId, status])
  @@map("obra_interferencias")
}

model ObraAvancoFisico {
  id          String   @id @default(uuid())
  contratoId  String   @map("contrato_id")
  dataRef     DateTime @map("data_ref")
  trecho      String                            // trecho / etapa (ex.: Rede Rua A, Elevatória 02)
  unidade     String   @default("m")            // m | m² | m³ | un | lig | %
  planejado   Float    @default(0)              // acumulado planejado até a data
  executado   Float    @default(0)              // acumulado executado até a data
  observacao  String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  contrato  Contract @relation("ObraAvancos", fields: [contratoId], references: [id])
  createdBy User     @relation("AvancosCriados", fields: [createdById], references: [id])

  @@index([contratoId, dataRef])
  @@map("obra_avancos_fisicos")
}

model RelatorioAcompanhamento {
  id             String   @id @default(uuid())
  contratoId     String   @map("contrato_id")
  dataVisita     DateTime @map("data_visita")
  analistaId     String   @map("analista_id")
  producaoDia    String?  @map("producao_dia")
  teveOcorrencia Boolean  @default(false) @map("teve_ocorrencia")
  ocorrencias    String?
  opiniao        String?                            // análise do analista comparando com o planejado
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  contrato Contract                @relation("AcompanhamentoContrato", fields: [contratoId], references: [id])
  analista User                    @relation("AcompanhamentoAnalista", fields: [analistaId], references: [id])
  funcoes  RelatorioAcompFuncao[]
  ativos   RelatorioAcompAtivo[]

  @@index([contratoId])
  @@index([dataVisita])
  @@map("relatorios_acompanhamento")
}

model RelatorioAcompFuncao {
  id          String @id @default(uuid())
  relatorioId String @map("relatorio_id")
  funcao      String
  quantidade  Int    @default(0)

  relatorio RelatorioAcompanhamento @relation(fields: [relatorioId], references: [id], onDelete: Cascade)

  @@index([relatorioId])
  @@map("relatorio_acomp_funcoes")
}

model RelatorioAcompAtivo {
  id          String  @id @default(uuid())
  relatorioId String  @map("relatorio_id")
  ativoId     String? @map("ativo_id")          // null se locação externa (manual)
  tipo        String                            // maquina | equipamento | veiculo
  descricao   String
  quantidade  Int     @default(1)
  origem      String  @default("rental")        // rental | externo

  relatorio RelatorioAcompanhamento @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  ativo     Ativo?                  @relation("AcompAtivo", fields: [ativoId], references: [id])

  @@index([relatorioId])
  @@map("relatorio_acomp_ativos")
}

model TreinamentoCatalogo {
  id            String   @id @default(uuid())
  nome          String   @unique
  descricao     String?
  validadeMeses Int?     @map("validade_meses")   // validade padrão em meses (opcional)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("treinamentos_catalogo")
}

model FuncionarioTreinamento {
  id            String    @id @default(uuid())
  funcionarioId String    @map("funcionario_id")
  nome          String                              // ex.: NR-35, NR-10, Integração
  realizadoEm   DateTime? @map("realizado_em")
  validade      DateTime?
  observacao    String?
  createdAt     DateTime  @default(now()) @map("created_at")

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@map("funcionario_treinamentos")
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String   
  objectType String?  @map("object_type") 
  objectId   String?  @map("object_id")
  metadata   String?
  ipAddress  String?  @map("ip_address") 
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── AVISO DE AUSÊNCIA / COBERTURA DE FÉRIAS ─────────────────────────────────

model AvisoAusencia {
  id           String    @id @default(uuid())
  usuarioId    String    @map("usuario_id")      // quem está ausente
  substitutoId String    @map("substituto_id")   // quem cobre
  criadoPorId  String    @map("criado_por_id")
  motivo       String    @default("ferias")
  // ferias | licenca_medica | viagem | outro
  dataInicio   DateTime  @map("data_inicio")
  dataFim      DateTime? @map("data_fim")        // null = sem previsão de retorno
  ativo        Boolean   @default(true)
  observacoes  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  usuario    User @relation("AusenciaUsuario",    fields: [usuarioId],    references: [id])
  substituto User @relation("AusenciaSubstituto", fields: [substitutoId], references: [id])
  criadoPor  User @relation("AusenciaCriadoPor",  fields: [criadoPorId],  references: [id])

  @@index([usuarioId, ativo])
  @@index([substitutoId, ativo])
  @@map("avisos_ausencia")
}

// ─── TAREFAS PESSOAIS ────────────────────────────────────────────────────────

model TarefaPessoal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  titulo      String
  descricao   String?
  status      String    @default("pendente")
  // pendente | em_andamento | concluida | cancelada
  prioridade  String    @default("media")
  // baixa | media | alta | urgente
  categoria   String?
  prazo       DateTime?
  recorrente  Boolean   @default(false)
  recorrencia String?   @map("recorrencia")
  // diaria | semanal | quinzenal | mensal
  concluidaEm DateTime? @map("concluida_em")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation("TarefasPessoais", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([prazo])
  @@map("tarefas_pessoais")
}

// ─── COMUNICADOS (Central Oficial de Comunicação) ────────────────────────────

model Comunicado {
  id          String   @id @default(uuid())
  title       String
  body        String
  authorId    String   @map("author_id")
  prioridade  String   @default("normal")  // normal | importante | urgente
  alvoTipo    String   @default("todos") @map("alvo_tipo")    // todos | area
  alvoAreaId  String?  @map("alvo_area_id")
  exigeAceite Boolean  @default(true) @map("exige_aceite")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  author   User                @relation("ComunicadosCriados", fields: [authorId], references: [id])
  alvoArea Area?               @relation("ComunicadosArea", fields: [alvoAreaId], references: [id])
  leituras ComunicadoLeitura[]

  @@index([ativo, createdAt])
  @@index([authorId])
  @@map("comunicados")
}

model ComunicadoLeitura {
  id           String    @id @default(uuid())
  comunicadoId String    @map("comunicado_id")
  userId       String    @map("user_id")
  lidoEm       DateTime  @default(now()) @map("lido_em")
  aceiteEm     DateTime? @map("aceite_em")

  comunicado Comunicado @relation(fields: [comunicadoId], references: [id], onDelete: Cascade)
  user       User       @relation("ComunicadoLeituras", fields: [userId], references: [id])

  @@unique([comunicadoId, userId])
  @@index([userId])
  @@map("comunicado_leituras")
}
